# Leave these unset to run on the built-in seed gallery.
# Create a project at sanity.io/manage, then fill these in.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01

# Shared secret for the Sanity webhook that busts the gallery cache.
# Must match the secret set on the webhook in sanity.io/manage.
SANITY_REVALIDATE_SECRET=

# Canonical origin for metadata, sitemap and robots.
# Default in production: https://vitrine-fawn.vercel.app
# Replace this when the custom domain is ready.
NEXT_PUBLIC_SITE_URL=https://vitrine-fawn.vercel.app

# Google Analytics 4 measurement ID (G-XXXXXXXX). Leave blank to disable.
NEXT_PUBLIC_GA_ID=

# Google Search Console HTML tag verification.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools meta verification (msvalidate.01).
BING_SITE_VERIFICATION=

# Desk login — required to publish from /admin.
# Password must be at least 8 characters. Session secret at least 16.
ADMIN_EMAIL=admin@spiffing.local
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Set to false only if you must test production mode over HTTP.
# SESSION_COOKIE_SECURE=true

# Vercel Blob — provisioned by `vercel blob create-store`, then `vercel env pull`.
# On Vercel this is injected automatically once the store is linked.
BLOB_READ_WRITE_TOKEN=
