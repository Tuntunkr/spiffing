# Leave these unset to run on the built-in seed gallery.
# Create a project at sanity.io/manage, then fill these in.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01

# Shared secret for the Sanity webhook that busts the gallery cache.
# Must match the secret set on the webhook in sanity.io/manage.
SANITY_REVALIDATE_SECRET=

# Clerk — provisioned by `vercel integration add clerk`, then `vercel env pull`.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
